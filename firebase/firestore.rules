rules_version = '2';

// VibeChat Firestore security rules.
//
// Model:
//   /users/{uid}                       — profile doc; readable + writable only by owner
//   /chatRooms/{roomId}                — readable/writable only by listed participants
//   /chatRooms/{roomId}/messages/{id}  — readable by participants; writable only by sender
//
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isParticipant(roomData) {
      return isSignedIn() && request.auth.uid in roomData.participants;
    }

    function roomDoc(roomId) {
      return get(/databases/$(database)/documents/chatRooms/$(roomId));
    }

    // ─── Users ────────────────────────────────────────────────────────
    // Anyone signed in can read a profile (for displaying names/avatars in
    // shared rooms). Only the owner can write — and they can never change
    // their uid or email through client writes.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.email == request.auth.token.email;
      allow update: if isSelf(uid)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email;
      allow delete: if false; // soft-delete via admin SDK / Cloud Function
    }

    // ─── Chat rooms ───────────────────────────────────────────────────
    match /chatRooms/{roomId} {
      allow read: if isParticipant(resource.data);

      // Create: the creator must be in the participants list.
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() >= 2;

      // Update: must already be a participant, and cannot evict themselves
      // out of the room or rewrite history of who participates (except in
      // explicit group-admin flows you'd add later).
      allow update: if isParticipant(resource.data)
                    && request.auth.uid in request.resource.data.participants;

      allow delete: if false;

      // ─── Messages sub-collection ───────────────────────────────────
      match /messages/{messageId} {
        allow read: if isParticipant(roomDoc(roomId).data);

        // Sender must be the caller and must be a room participant.
        allow create: if isSignedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in roomDoc(roomId).data.participants;

        // Allow the sender to soft-delete their own message: only the
        // `deleted`, `text`, and `imageUrl` fields can change, and `deleted`
        // must become true. Everything else stays immutable from clients.
        allow update: if isSignedIn()
                      && resource.data.senderId == request.auth.uid
                      && request.resource.data.deleted == true
                      && request.resource.data.senderId == resource.data.senderId
                      && request.resource.data.type == resource.data.type
                      && request.resource.data.createdAt == resource.data.createdAt;

        // Hard deletes go through a Cloud Function only.
        allow delete: if false;
      }
    }
  }
}
